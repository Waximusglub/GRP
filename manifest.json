{
  "manifest_version": 3,
  "name": "GRP!",
  "description": "Eats and brups the size of the github repo you are looking.",
  "version": "1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
    "host_permissions": [
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}